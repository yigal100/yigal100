#!/usr/bin/env bash
#MISE description="Cut a new release (update CHANGELOG.md, commit, tag, and push to trigger GitHub release)"
#USAGE arg "[version]" help="Target version (e.g. 0.2.0); defaults to next bumped version"
#USAGE flag "--local" help="Create commit and tag locally without pushing"
set -euo pipefail

if ! git diff-index --quiet HEAD --; then
  echo "Error: Uncommitted changes detected. Commit or stash them before cutting a release." >&2
  exit 1
fi

IS_LOCAL="${usage_local:-false}"

VERSION_ARG="${usage_version:-${1:-}}"
if [ -n "$VERSION_ARG" ]; then
  VERSION="$VERSION_ARG"
else
  VERSION="$(git-cliff --bumped-version 2>/dev/null || true)"
  if [ -z "$VERSION" ]; then
    echo "Error: Could not determine next version automatically." >&2
    echo "Usage: mise run release [version]" >&2
    exit 1
  fi
fi

TAG="v${VERSION#v}"
echo "==> Cutting release: ${TAG}"

git-cliff --tag "${TAG}" -o CHANGELOG.md
git add CHANGELOG.md
git commit -m "chore(release): prepare for ${TAG}"
git tag -a "${TAG}" -m "Release ${TAG}"

if [ "$IS_LOCAL" = "true" ]; then
  echo "==> Local release ${TAG} created!"
  echo "    Commit: $(git rev-parse --short HEAD)"
  echo "    Tag:    ${TAG}"
  echo "    Push:   git push origin HEAD ${TAG}"
  exit 0
fi

echo "==> Pushing commit and tag ${TAG}..."
git push origin HEAD "${TAG}"

echo "==> Release ${TAG} pushed! GitHub Actions will build and publish the release."
